<?xml version="1.0" encoding="UTF-8"?>
<!--
  TailwindJCINK Skin Import File

  INSTALLATION:
  1. Go to Admin CP > Skins & Templates > HTML Templates
  2. Under "Choose a skin XML file to extract the templates from", click Browse
  3. Select this file and click "Create a new HTML Template Set"
  4. IMPORTANT: You still need to install the Board Wrapper and Stylesheet separately
     (see Steps 2-3 in README.md)
-->
<skin>
  <skin_name>TailwindJCINK</skin_name>
  <skin_author>TailwindJCINK</skin_author>
  <skin_version>1.0.0</skin_version>

  <templates>
    <!-- Board Index Templates -->
    <template>
      <template_name>Category Row</template_name>
      <template_group>Board Index Templates</template_group>
      <template_content><![CDATA[<section class="forum-card mb-6" id="category-<%CAT_ID%>">
  <!-- Category Header -->
  <div class="forum-card-header">
    <h2 class="text-lg font-semibold flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
      </svg>
      <%CAT_NAME%>
    </h2>
  </div>

  <!-- Forum Rows Container -->
  <div class="divide-y divide-forum-border">
    <%FORUM_ROWS%>
  </div>
</section>]]></template_content>
    </template>

    <template>
      <template_name>Forum Row</template_name>
      <template_group>Board Index Templates</template_group>
      <template_content><![CDATA[<div class="category-row group" id="forum-<%FORUM_ID%>">
  <!-- Color Marker Bar -->
  <div class="category-marker bg-category-1"></div>

  <!-- Forum Icon/Status -->
  <div class="category-icon">
    <%FORUM_ICON%>
  </div>

  <!-- Forum Info -->
  <div class="category-info">
    <a href="<%FORUM_LINK%>" class="category-title">
      <%FORUM_NAME%>
    </a>
    <p class="category-description">
      <%FORUM_DESC%>
    </p>

    <!-- Subforums (if any) -->
    <div class="mt-2 text-sm" id="subforums-<%FORUM_ID%>">
      <%SUBFORUMS%>
    </div>
  </div>

  <!-- Statistics -->
  <div class="category-stats hidden lg:flex">
    <div class="text-center">
      <div class="font-semibold text-forum-text"><%TOPICS%></div>
      <div class="text-xs">Topics</div>
    </div>
    <div class="text-center">
      <div class="font-semibold text-forum-text"><%REPLIES%></div>
      <div class="text-xs">Posts</div>
    </div>
  </div>

  <!-- Last Post Info -->
  <div class="category-last-post hidden md:block">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-slate-200 dark:bg-slate-700 flex-shrink-0 overflow-hidden"></div>
      <div class="min-w-0 flex-1">
        <a href="<%LAST_TOPIC_LINK%>" class="text-sm font-medium text-forum-text hover:text-forum-accent block truncate">
          <%LAST_TOPIC%>
        </a>
        <p class="text-xs text-forum-text-muted mt-0.5">
          by <a href="<%LAST_POSTER_LINK%>" class="hover:text-forum-accent"><%LAST_POSTER%></a>
          <span class="mx-1">&bull;</span>
          <span><%LAST_POST_TIME%></span>
        </p>
      </div>
    </div>
  </div>
</div>]]></template_content>
    </template>

    <!-- Topic List Templates -->
    <template>
      <template_name>Topic List Wrapper</template_name>
      <template_group>Topic List Templates</template_group>
      <template_content><![CDATA[<div class="topic-list-wrapper">
  <!-- Forum Header -->
  <div class="forum-card mb-4">
    <div class="forum-card-header">
      <div class="flex items-center justify-between">
        <h1 class="text-xl font-bold"><%FORUM_NAME%></h1>
        <div class="flex items-center gap-2">
          <%NEW_TOPIC_BTN%>
        </div>
      </div>
      <p class="text-white/80 text-sm mt-1"><%FORUM_DESC%></p>
    </div>
  </div>

  <!-- Forum Rules (if any) -->
  <div class="alert alert-info mb-4" id="forum-rules">
    <%FORUM_RULES%>
  </div>

  <!-- Topic List Header -->
  <div class="forum-card">
    <!-- Column Headers -->
    <div class="px-5 py-3 bg-slate-50 dark:bg-slate-800/50 border-b border-forum-border">
      <div class="flex items-center gap-4 text-sm font-medium text-forum-text-muted">
        <div class="w-10"></div>
        <div class="flex-1">Topic</div>
        <div class="hidden lg:block w-[120px] text-center">Stats</div>
        <div class="hidden md:block w-[180px] text-right">Last Post</div>
      </div>
    </div>

    <!-- Topics -->
    <div class="divide-y divide-forum-border">
      <%TOPICS%>
    </div>

    <!-- Pagination Footer -->
    <div class="forum-card-footer flex items-center justify-between">
      <div class="text-sm text-forum-text-muted">
        <%SORT_OPTIONS%>
      </div>
      <nav class="pagination">
        <%PAGINATION%>
      </nav>
    </div>
  </div>

  <!-- Moderators -->
  <div class="mt-4 text-sm text-forum-text-muted">
    <span class="font-medium">Moderators:</span> <%MODERATORS%>
  </div>
</div>]]></template_content>
    </template>

    <!-- Topic View Templates -->
    <template>
      <template_name>Post Row</template_name>
      <template_group>Topic View Templates</template_group>
      <template_content><![CDATA[<article class="post" id="post-<%POST_ID%>">
  <!-- Mini Profile Sidebar -->
  <aside class="post-sidebar hidden md:block">
    <%MINI_PROFILE%>
  </aside>

  <!-- Post Content Area -->
  <div class="post-content">
    <!-- Post Header -->
    <header class="post-header">
      <div class="flex items-center gap-3">
        <!-- Mobile Avatar -->
        <img src="<%MEMBER_AVATAR%>" alt="<%MEMBER_NAME%>" class="w-10 h-10 rounded-full md:hidden">

        <div>
          <!-- Mobile: Show name -->
          <a href="<%MEMBER_LINK%>" class="font-semibold text-forum-text hover:text-forum-accent md:hidden">
            <%MEMBER_NAME%>
          </a>

          <!-- Post Date & Number -->
          <div class="text-sm text-forum-text-muted">
            <a href="<%POST_LINK%>" class="hover:text-forum-accent" title="Link to this post">
              <time><%POST_DATE%></time>
            </a>
            <span class="mx-2">&bull;</span>
            <a href="<%POST_LINK%>" class="hover:text-forum-accent">
              #<%POST_NUMBER%>
            </a>
          </div>
        </div>
      </div>

      <!-- Post Actions (Top) -->
      <div class="flex items-center gap-1">
        <%MULTIQUOTE%>
        <a href="<%POST_LINK%>" class="btn btn-ghost btn-sm" title="Permalink">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
          </svg>
        </a>
      </div>
    </header>

    <!-- Post Body -->
    <div class="post-body">
      <%POST_CONTENT%>
    </div>

    <!-- Edited By Notice -->
    <div class="text-xs text-forum-text-muted mt-3 italic">
      <%EDITED_BY%>
    </div>

    <!-- Signature -->
    <div class="signature">
      <%SIGNATURE%>
    </div>

    <!-- Post Footer -->
    <footer class="post-footer">
      <!-- Left Side: IP Address (admin only) -->
      <div class="text-xs text-forum-text-muted">
        <%IP_ADDRESS%>
      </div>

      <!-- Right Side: Action Buttons -->
      <div class="post-actions">
        <span class="inline-flex items-center gap-1"><%REPORT_BUTTON%></span>
        <span class="inline-flex items-center gap-1"><%QUOTE_BUTTON%></span>
        <span class="inline-flex items-center gap-1"><%EDIT_BUTTON%></span>
        <span class="inline-flex items-center gap-1"><%DELETE_BUTTON%></span>
      </div>
    </footer>
  </div>
</article>]]></template_content>
    </template>

    <template>
      <template_name>Mini Profile</template_name>
      <template_group>Topic View Templates</template_group>
      <template_content><![CDATA[<div class="mini-profile" id="mini-profile-<%MEMBER_ID%>">
  <!-- Avatar -->
  <div class="relative inline-block">
    <a href="<%MEMBER_LINK%>">
      <img src="<%MEMBER_AVATAR%>" alt="<%MEMBER_NAME%>" class="mini-profile-avatar" loading="lazy">
    </a>

    <!-- Online Status Indicator -->
    <div class="absolute bottom-1 right-1">
      <%ONLINE_STATUS%>
    </div>
  </div>

  <!-- Member Name -->
  <div class="mt-3">
    <a href="<%MEMBER_LINK%>" class="mini-profile-name hover:text-forum-accent transition-colors">
      <%MEMBER_NAME%>
    </a>
  </div>

  <!-- Member Group Badge -->
  <div class="mt-1">
    <%MEMBER_GROUP%>
  </div>

  <!-- Custom Title -->
  <div class="text-xs text-forum-text-muted italic mt-1">
    <%MEMBER_TITLE%>
  </div>

  <!-- Member Pips/Stars -->
  <div class="mt-2 text-amber-500">
    <%MEMBER_PIPS%>
  </div>

  <!-- Member Stats -->
  <div class="mini-profile-stats">
    <div class="flex items-center justify-center gap-1">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
      </svg>
      <span><%MEMBER_POSTS%> posts</span>
    </div>

    <div class="flex items-center justify-center gap-1">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <span>Joined <%MEMBER_JOINED%></span>
    </div>

    <!-- Location (if set) -->
    <div class="flex items-center justify-center gap-1">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      <span><%MEMBER_LOCATION%></span>
    </div>
  </div>

  <!-- Reputation Display -->
  <div class="mt-2">
    <%REPUTATION_DISPLAY%>
  </div>

  <!-- Custom Profile Fields -->
  <div class="mt-2 text-xs">
    <%PROFILE_FIELDS%>
  </div>

  <!-- Contact Icons -->
  <div class="mini-profile-icons">
    <%CONTACT_ICONS%>
  </div>

  <!-- Warn Link (Moderator only) -->
  <div class="mt-2">
    <%WARN_LINK%>
  </div>
</div>]]></template_content>
    </template>

    <!-- Profile Templates -->
    <template>
      <template_name>Profile</template_name>
      <template_group>Profile Templates</template_group>
      <template_content><![CDATA[<div class="profile-wrapper">
  <!-- Profile Header -->
  <div class="forum-card mb-6">
    <div class="relative">
      <!-- Cover/Banner Area -->
      <div class="h-32 md:h-48 bg-gradient-to-r from-primary-600 to-primary-800 rounded-t-lg"></div>

      <!-- Profile Info Overlay -->
      <div class="px-6 pb-6">
        <div class="flex flex-col md:flex-row md:items-end gap-4 -mt-16 md:-mt-20">
          <!-- Avatar -->
          <div class="flex-shrink-0">
            <img src="<%MEMBER_AVATAR%>" alt="<%MEMBER_NAME%>" class="w-32 h-32 md:w-40 md:h-40 rounded-full border-4 border-white dark:border-slate-800 shadow-lg object-cover">
          </div>

          <!-- Name & Group -->
          <div class="flex-1 md:pb-2">
            <h1 class="text-2xl md:text-3xl font-bold text-forum-text">
              <%MEMBER_NAME%>
            </h1>
            <div class="mt-1">
              <%MEMBER_GROUP%>
            </div>
            <p class="text-forum-text-muted mt-1"><%MEMBER_TITLE%></p>
          </div>

          <!-- Action Buttons -->
          <div class="flex items-center gap-2 md:pb-2">
            <a href="<%PM_LINK%>" class="btn btn-primary">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Message
            </a>
            <%ADMIN_OPTIONS%>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Profile Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left Sidebar -->
    <div class="space-y-6">
      <!-- Stats Card -->
      <div class="forum-card">
        <div class="forum-card-body">
          <h3 class="font-semibold text-forum-text mb-4">Statistics</h3>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-forum-text-muted">Posts</span>
              <span class="font-semibold text-forum-text"><%MEMBER_POSTS%></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-forum-text-muted">Reputation</span>
              <span class="font-semibold text-green-600"><%MEMBER_REPUTATION%></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-forum-text-muted">Joined</span>
              <span class="text-forum-text"><%MEMBER_JOINED%></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-forum-text-muted">Last Active</span>
              <span class="text-forum-text"><%MEMBER_LAST_ACTIVE%></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Personal Info Card -->
      <div class="forum-card">
        <div class="forum-card-body">
          <h3 class="font-semibold text-forum-text mb-4">Personal Information</h3>
          <div class="space-y-3 text-sm">
            <div class="flex items-start gap-3">
              <svg class="w-4 h-4 mt-0.5 text-forum-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <div>
                <div class="text-forum-text-muted">Birthday</div>
                <div class="text-forum-text"><%MEMBER_BIRTHDAY%></div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-4 h-4 mt-0.5 text-forum-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <div>
                <div class="text-forum-text-muted">Location</div>
                <div class="text-forum-text"><%MEMBER_LOCATION%></div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-4 h-4 mt-0.5 text-forum-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
              </svg>
              <div>
                <div class="text-forum-text-muted">Website</div>
                <div class="text-forum-text">
                  <a href="<%MEMBER_WEBSITE%>" target="_blank" rel="noopener" class="hover:text-forum-accent"><%MEMBER_WEBSITE%></a>
                </div>
              </div>
            </div>
          </div>
          <!-- Custom Profile Fields -->
          <div class="mt-4 pt-4 border-t border-forum-border">
            <%PROFILE_FIELDS%>
          </div>
        </div>
      </div>

      <!-- Contact Card -->
      <div class="forum-card">
        <div class="forum-card-body">
          <h3 class="font-semibold text-forum-text mb-4">Contact</h3>
          <div class="flex flex-wrap gap-2">
            <%CONTACT_INFO%>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="lg:col-span-2 space-y-6">
      <!-- About Me -->
      <div class="forum-card">
        <div class="forum-card-body">
          <h3 class="font-semibold text-forum-text mb-4">About Me</h3>
          <div class="text-forum-text leading-relaxed">
            <%MEMBER_BIO%>
          </div>
        </div>
      </div>

      <!-- Interests -->
      <div class="forum-card">
        <div class="forum-card-body">
          <h3 class="font-semibold text-forum-text mb-4">Interests</h3>
          <p class="text-forum-text"><%MEMBER_INTERESTS%></p>
        </div>
      </div>

      <!-- Recent Activity -->
      <div class="forum-card">
        <div class="forum-card-body">
          <h3 class="font-semibold text-forum-text mb-4">Recent Posts</h3>
          <div class="divide-y divide-forum-border -mx-5">
            <%RECENT_POSTS%>
          </div>
        </div>
      </div>

      <!-- Signature -->
      <div class="forum-card">
        <div class="forum-card-body">
          <h3 class="font-semibold text-forum-text mb-4">Signature</h3>
          <div class="signature border-0 pt-0 mt-0">
            <%MEMBER_SIGNATURE%>
          </div>
        </div>
      </div>

      <!-- Profile Comments -->
      <div class="forum-card">
        <div class="forum-card-body">
          <h3 class="font-semibold text-forum-text mb-4">Profile Comments</h3>
          <div class="space-y-4">
            <%COMMENTS%>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>]]></template_content>
    </template>
  </templates>
</skin>
